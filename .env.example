# Express Server Configuration
PORT=3000

# JWT Configuration (REQUIRED in production — minimum 32 characters, unique secret)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotation: issue new secret, redeploy, invalidate sessions; do not reuse defaults.
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Environment mode (production enforces strong JWT_SECRET)
NODE_ENV=development

# Test mode disables rate limits and CSRF checks for automated suites only
# KEEPUP_TEST_MODE=true

# Supabase Configuration (Optional — falls back to local JSON database if empty)
SUPABASE_URL=
SUPABASE_KEY=

# Force local JSON database (useful for offline development and tests)
# FORCE_LOCAL_DB=true

# File Upload Configuration
FILE_SIZE_LIMIT=10485760

# OCR / Search tuning
OCR_MIN_TEXT_LENGTH=10
MAX_PDF_PAGES=10
OCR_PROCESS_TIMEOUT_SECONDS=120
SEARCH_MIN_QUERY_LENGTH=2
SEARCH_MAX_RESULTS=50

# Rate limiting (in-memory store; use Redis for multi-instance production)
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=10
UPLOAD_RATE_LIMIT_MAX_REQUESTS=20
SEARCH_RATE_LIMIT_WINDOW_MINUTES=1
SEARCH_RATE_LIMIT_MAX_REQUESTS=60
